# Use an exact tool-capable model ID returned by https://ai-gateway.vercel.sh/v1/models
# This model was present in the catalog when the project was authored.
AI_GATEWAY_MODEL=openai/gpt-6-luna
# Needed locally; Vercel can use its project OIDC authentication when enabled.
AI_GATEWAY_API_KEY=
# Shared study-coach access code. Use a long, unique value; share only with the intended learner.
STUDY_ACCESS_CODE=
# Generate a separate random signing secret of at least 32 characters.
STUDY_SESSION_SECRET=
